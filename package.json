{
  "name": "video-converter",
  "private": true,
  "version": "0.1.0",
  "description": "Converts iPhone screen recordings (HEVC) to H.264 MP4 in the browser with FFmpeg.wasm. Nothing is uploaded.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "serve": "node scripts/serve.mjs",
    "start": "node scripts/build.mjs && node scripts/serve.mjs",
    "test": "node --test \"tests/unit/*.test.js\"",
    "fixtures": "bash scripts/make-fixtures.sh",
    "e2e": "node scripts/build.mjs && playwright test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@ffmpeg/core": "0.12.10",
    "@ffmpeg/ffmpeg": "0.12.15"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1"
  }
}
